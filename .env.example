# Section visibility — set to false to hide a section (and its nav item).
# Defaults to true when omitted.
# Restart `next dev` after changing these.

SECTION_HOME=true
SECTION_ABOUT=true
SECTION_EDUCATION=true
SECTION_PROJECTS=true
SECTION_CERTIFICATES=true
SECTION_CONTACT=true

# =============================================================================
# Skills & certificates DATA (add / remove content here)
# =============================================================================
# Edit these bundled catalogs:
#   content/skills.json
#   content/certificates.json
#
# To ADD an item  → add an object to the JSON file (or use *_EXTRA below)
# To REMOVE one   → delete it from the JSON file (or use *_HIDE / allowlist)

# Optional: full inline JSON catalog (overrides the bundled file if set)
# SKILLS_JSON=[{"id":"react","label":"React","category":"frontend","layer":"frontend","role":"Framework","group":"frameworks","icon":"react","description":"...","related":["next"],"map":{"x":38,"y":56}}]
# CERTIFICATES_JSON=[{"id":"my-cert","title":"...","issuer":"...","date":"...","summary":"...","skills":["React"],"image":"/certificates/file.png"}]

# Optional: append / upsert items without editing the main JSON file
# SKILLS_EXTRA=[{"id":"vue","label":"Vue","category":"frontend","layer":"frontend","role":"Framework","group":"frameworks","icon":"react","description":"Progressive UI framework.","related":[],"map":{"x":40,"y":50}}]
# CERTIFICATES_EXTRA=[{"id":"thm-advent-of-cyber-2025","title":"Advent of Cyber 2025","issuer":"TryHackMe","date":"2025","summary":"...","skills":["Cybersecurity"],"image":"/certificates/THM-Advent-Of-Cyber-2025.jpg"}]

# Optional filters on top of the loaded catalog
# SKILLS=figma,react,next,ts          → show ONLY these ids (order preserved)
# SKILLS_HIDE=kubernetes,testing-fe   → hide these ids
# CERTIFICATES=fcc-frontend-libraries,thm-advent-of-cyber-2025
# CERTIFICATES_HIDE=fcc-backend-apis

# Category toggles (default true)
SKILL_CATEGORY_DESIGN=true
SKILL_CATEGORY_FRONTEND=true
SKILL_CATEGORY_BACKEND=true
SKILL_CATEGORY_DATA=true
SKILL_CATEGORY_SECURITY=true
SKILL_CATEGORY_DEVOPS=true
SKILL_CATEGORY_AI=true
